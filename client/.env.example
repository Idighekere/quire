# ── Client (Vite) ─────────────────────────────────────────────────────────
# Base URL of the API server the browser should call (with credentials).
# Must include the /api/v1 prefix.
VITE_BASE_URL=http://localhost:5000/api/v1
# development | production
VITE_NODE_ENV=development
# Google API key for the Drive picker (Import from Drive in moderation).
# Cloud console → Credentials → Create API key, restrict HTTP referrers to
# this app's origin. No new OAuth scope needed (uses the drive.file grant).
VITE_GOOGLE_PICKER_API_KEY=
# Cloud project number (Cloud console home → Project number), used as the
# picker App ID. Optional but recommended.
VITE_GOOGLE_PROJECT_NUMBER=