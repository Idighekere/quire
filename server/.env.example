# ── Server ────────────────────────────────────────────────────────────────
# Port the API listens on (server.ts is the single owner of this port).
PORT=5000
# NODE_ENV=development | production (controls cookie security, CORS, rate limits)
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/faculty-library

# ── Auth (JWT) ────────────────────────────────────────────────────────────
ACCESS_SECRET=change-me-access-secret
REFRESH_SECRET=change-me-refresh-secret
ACCESS_EXPIRES_IN=900
REFRESH_EXPIRES_IN=2592000

# ── Frontend ──────────────────────────────────────────────────────────────
# Origin the browser redirects/authorizes against (client app).
FRONTEND_URL=http://localhost:5173
# Comma-separated list of EVERY frontend origin served by this API
# (current + previous frontends, preview URLs). Drives CORS and validates
# Google sign-in return redirects. Falls back to FRONTEND_URL when unset.
# FRONTEND_ORIGINS=http://localhost:5173,https://faculty-library.netlify.app

# ── Google Drive ──────────────────────────────────────────────────────────
# Reads/sync and writes all run as the designated library admin's Google
# account: the first admin to sign in with Google connects the shared
# library Drive, and their stored OAuth token (`drive.file` scope) is
# reused server-side — single ownership/quota no matter who uploads.
# Uploaders just log in normally; no per-uploader Google Drive grant or
# Editor share is needed.
# 1. Create the library root folder in the admin's Drive.
# 2. Fill in the folder ID below, then have an admin sign in with Google
#    once to connect reads/sync and uploads.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Google Sign-In (OAuth 2.0) ─────────────────────────────────────────
# 1. In the SAME Google Cloud project, configure the OAuth consent screen
#    (External): app name + support email, scopes `email` + `profile`.
#    While the app is in "Testing" mode, add each tester Gmail under
#    "Test users" or Google will block them with Error 403.
# 2. Credentials → Create Credentials → OAuth client ID → Web application.
# 3. Under "Authorized redirect URIs" add EXACTLY the line below for local
#    dev (and your https API callback URL for production), then paste the
#    issued Client ID / Client Secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback